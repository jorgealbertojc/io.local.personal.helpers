#!/bin/bash



set -uo pipefail



export EXECUTION_UUID=$(uuidgen)
export EXECUTION_TIMESTAMP=$(date +%s.%3N)
export EXECUTION_LOGFILE_NAME="${EXECUTION_TIMESTAMP}-${EXECUTION_UUID}-apt-update.log"
export EXECUTION_LOGFILE_PATH="/tmp/${EXECUTION_LOGFILE_NAME}"



function ___main {

    if [[ $EUID -ne 0 ]]; then
        echo "This script must be run as root"
        exit 1
    fi

    echo "-- updating apt packages"
    sudo apt \
        -o Apt::Cmd::Disable-Script-Warning=true \
        -y update --fix-missing >> ${EXECUTION_LOGFILE_PATH} 2>&1
    if [[ $? -ne 0 ]]; then
        cat ${EXECUTION_LOGFILE_PATH}
        echo ">>> ERROR: apt update failed, please check the log file for details: ${EXECUTION_LOGFILE_PATH}"
        exit 1
    fi

    echo "-- upgrading apt packages"
    echo "   this can take a while depending on the number of packages to upgrades, please be patient!"
    sudo apt \
        -o Apt::Cmd::Disable-Script-Warning=true \
        -y upgrade --fix-missing --fix-broken >> ${EXECUTION_LOGFILE_PATH} 2>&1
    if [[ $? -ne 0 ]]; then
        cat ${EXECUTION_LOGFILE_PATH}
        echo ">>> ERROR: apt upgrade failed, please check the log file for details: ${EXECUTION_LOGFILE_PATH}"
        exit 1
    fi

    echo "-- updating ffmpeg library for Opera Browser"
    sudo ln -vsf \
        /snap/chromium/current/usr/lib/chromium-browser/libffmpeg.so \
        /usr/lib/x86_64-linux-gnu/opera-stable/libffmpeg.so >> ${EXECUTION_LOGFILE_PATH} 2>&1
    if [[ $? -ne 0 ]]; then
        cat ${EXECUTION_LOGFILE_PATH}
        echo ">>> ERROR: failed to update ffmpeg library for Opera Browser, please check the log file for details: ${EXECUTION_LOGFILE_PATH}"
        exit 1
    fi

    echo ""
    echo "::> DONE <::"
}



___main "${@}"
